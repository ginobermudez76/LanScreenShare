<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="420"
        x:Class="LanScreenShare.Desktop.VddDriverInstallerWindow"
        Title="Instalar controlador de pantalla virtual"
        Width="540" Height="420"
        MinWidth="480" MinHeight="380"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#121822"
            BorderBrush="#263246"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid x:Name="HeaderDragGrid"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="22,18,22,10"
                  Background="Transparent">
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="10"
                        Background="#1E1B4B"
                        BorderBrush="#4338CA"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <PathIcon Data="{StaticResource IconAllScreens}"
                              Width="18" Height="18"
                              Foreground="#A5B4FC"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Controlador de Monitor Inalámbrico"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>
                    <TextBlock Text="Requerido una única vez para crear pantallas extendidas en Windows."
                               FontSize="12"
                               Foreground="#8B9BB0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="CloseWindowButton"
                        Background="#1D2532"
                        BorderBrush="#2A3446"
                        BorderThickness="1"
                        Width="32" Height="32"
                        CornerRadius="8"
                        Cursor="Hand"
                        ToolTip.Tip="Cerrar (Esc)">
                    <PathIcon Data="{StaticResource IconClose}"
                              Width="12" Height="12"
                              Foreground="#CBD5E1"/>
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="22,6,22,12" Spacing="12">
                <Border Background="#161E2B"
                        BorderBrush="#243044"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Principio de mínimo privilegio (asInvoker + UAC efímero)"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"/>
                        <TextBlock Text="LanScreenShare se ejecuta siempre como usuario estándar. Para activar el monitor virtual IDDCx firmado (compatible con Secure Boot), Windows solicitará confirmación de administrador una sola vez."
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   LineHeight="17"/>
                    </StackPanel>
                </Border>

                <Border Background="#0F141D"
                        BorderBrush="#212B3B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="InstallMethodTitle"
                                   Text="Método detectado: pnputil local / winget"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#A5B4FC"/>
                        <TextBlock x:Name="CommandPreviewText"
                                   Text="pnputil.exe /add-driver &quot;Drivers\VDD\MttVDD.inf&quot; /install"
                                   FontFamily="Consolas, Monospace"
                                   FontSize="11"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultBanner"
                        IsVisible="False"
                        Background="#14291F"
                        BorderBrush="#1E4631"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,9">
                    <TextBlock x:Name="ResultBannerText"
                               FontSize="12"
                               Foreground="#E2E8F0"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#10151E"
                    BorderBrush="#1E2633"
                    BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="FooterHintText"
                               Text="También compatible si ya tienes Parsec VDD instalado."
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="1"
                            x:Name="CancelInstallButton"
                            Content="Cancelar"
                            Background="#1A2230"
                            BorderBrush="#263246"
                            BorderThickness="1"
                            Foreground="#CBD5E1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                    <Button Grid.Column="2"
                            x:Name="InstallDriverButton"
                            Content="Instalar controlador (UAC)"
                            Background="#4F46E5"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="16,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
