<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest Condition="'$(UsePackagedUiAccessManifest)' == 'true'">app.packaged.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UsePackagedUiAccessManifest)' != 'true'">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanScreenShare.Core\LanScreenShare.Core.csproj" />
    <ProjectReference Include="..\LanScreenShare.Network\LanScreenShare.Network.csproj" />
    <ProjectReference Include="..\LanScreenShare.Media\LanScreenShare.Media.csproj" />
    <ProjectReference Include="..\LanScreenShare.DisplayWatchdog\LanScreenShare.DisplayWatchdog.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDisplayWatchdogToOutput" AfterTargets="Build">
    <ItemGroup>
      <_WatchdogFiles Include="..\LanScreenShare.DisplayWatchdog\bin\$(Configuration)\$(TargetFramework)\LanScreenShare.DisplayWatchdog.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WatchdogFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDisplayWatchdogToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WatchdogPublishFiles Include="$(OutputPath)LanScreenShare.DisplayWatchdog.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WatchdogPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LanScreenShare.Tests" />
  </ItemGroup>
</Project>
